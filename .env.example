# Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Auth — langes Zufallsgeheimnis, z. B. openssl rand -hex 32
JWT_SECRET=bitte-aendern

# Öffentliche URL (für Links in Mails, z. B. Passwort-Reset)
APP_PUBLIC_URL=https://meal-planner.nas-timgreen.com
# Ohne SMTP zeigt die App den Reset-Link direkt an (nur für private Instanzen sinnvoll)
ALLOW_DEV_RESET_LINK=1
RESET_TTL_MINUTES=60

# Optionaler Mailversand für Passwort-Reset
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Meal Planner <noreply@example.com>

# KI-Provider: deepseek (Standard) | mistral | gemini
AI_ACTIVE_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# AI_DEEPSEEK_MODEL=deepseek-chat

# Optional als Fallback
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
